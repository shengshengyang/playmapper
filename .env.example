# 環境變數範例檔
# 複製此檔案為 .env 並修改設定

# 資料庫設定（用於 docker-compose.full.yml）
DB_PASSWORD=postgres123

# 外部資料庫設定（用於 docker-compose.yml，不包含 PostgreSQL）
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/family_map
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT 金鑰（生產環境請更換為安全的隨機字串）
JWT_SECRET=your-256-bit-secret-key-please-change-in-production-environment
